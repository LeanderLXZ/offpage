{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offpage/analysis/world_overview.schema.json",
  "title": "WorldOverview",
  "description": "Phase 1 全书世界观概览。基于全部 chapter_summary chunks 由 LLM 一次产出（与 stage_plan / candidate_characters 同次调用）。Phase 2 baseline 把它作为世界 foundation 的起点。",
  "type": "object",
  "required": [
    "work_id",
    "genre",
    "tone",
    "world_structure",
    "power_system",
    "major_factions",
    "world_lines",
    "core_rules"
  ],
  "additionalProperties": true,
  "properties": {
    "work_id": {
      "type": "string",
      "description": "作品包命名空间键。"
    },
    "genre": {
      "type": "string",
      "maxLength": 30,
      "description": "题材类型（≤30 字，例如\"东方玄幻\" / \"都市修真\"）。"
    },
    "tone": {
      "type": "string",
      "maxLength": 50,
      "description": "整体基调（≤50 字）。"
    },
    "world_structure": {
      "type": "object",
      "required": ["summary", "major_regions"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 100,
          "maxLength": 200,
          "description": "世界结构概述（100-200 字）。"
        },
        "major_regions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 15, "description": "区域 / 地名（≤15 字，对齐 chunk_regions.items.name）。" },
              "description": { "type": "string", "maxLength": 30, "description": "区域简要描述（≤30 字，对齐 chunk_regions.items.description）。" }
            }
          },
          "description": "主要区域列表（≤30 项）。形态对齐 chunk_regions.items，Phase 2 baseline 直接读用。"
        }
      }
    },
    "power_system": {
      "type": "object",
      "required": ["summary", "levels"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 100,
          "maxLength": 200,
          "description": "力量体系概述（100-200 字）。"
        },
        "levels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 15, "description": "等级 / 阶段名（≤15 字，对齐 chunk_power_levels.items.name，例如\"练气\"\"筑基\"）。" },
              "description": { "type": "string", "maxLength": 30, "description": "等级简要描述（≤30 字，对齐 chunk_power_levels.items.description）。" }
            }
          },
          "description": "力量体系等级列表（≤20 项）。形态对齐 chunk_power_levels.items，Phase 2 baseline 直接读用。"
        }
      }
    },
    "major_factions": {
      "type": "array",
      "maxItems": 20,
      "description": "主要势力（≤20 项）。",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 30 },
          "description": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "world_lines": {
      "type": "array",
      "maxItems": 20,
      "description": "大世界线 / 篇章划分（≤20 项）。",
      "items": {
        "type": "object",
        "required": ["name", "chapter_range", "core_conflict", "setting_features"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 30 },
          "chapter_range": {
            "type": "string",
            "pattern": "^C[0-9]{4}-C[0-9]{4}$",
            "description": "章节范围（C 前缀 + 4 位零填充 + 连字符 + C 前缀 + 4 位零填充，例如 C0001-C0010），与 chapter_id 命名一致。"
          },
          "core_conflict": { "type": "string", "maxLength": 100 },
          "setting_features": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "core_rules": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "maxLength": 150 },
      "description": "影响剧情走向的关键世界规则（≤30 条，每条 ≤150 字）。保留字符串数组形态——LLM 在 phase 1 综合 N chunk 的 chunk_world_rules 时去重 + 重新整理为完整规则描述，而非照搬 chunk 行。"
    }
  }
}
